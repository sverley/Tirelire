#!/bin/sh
# Pré-commit de Tirelire (#120, #127, #232, #266) : moins de 5 s. Pendant une fusion, voir livraison.sh.
#
# Les tests se choisissent d'après les fichiers du commit (l'index) et se jouent sur la copie de
# travail, en parallèle, au seuil 0 (#232 : seuls les tests de niveau 0, l'irréparable) :
#   packages/core/**                                   → tests du cœur (sans isolation, pour tenir le budget)
#   la garde (packages/gardes/**, docs/gardes.md, .github/**)
#   ou les règles (docs/decisions.md, docs/methodes.md, docs/description-projet.md,
#   docs/invariants.md, docs/contraintes.md, CLAUDE.md) → tests de la garde
#   apps/relay/**                                      → tests du relais
#   apps/hebergement/**                                → tests de l'hébergement
#   le reste (documentation, interface, configuration) → rien ; la livraison et la CI jugent le reste.
# Le harnais du besoin (`harnais-du-besoin.sh` : le fichier de l'auditeur, qui porte le numéro de
# l'issue) se joue à part, en entier (seuil 4), dès que des tests se jouent, hors budget ; le reste
# est la non-régression, jouée à son niveau. Sans tests navigateur (D83) : ses fichiers de
# `apps/web/test/navigateur/` ne se jouent pas au commit, qui les nomme ; ils se jouent à la
# livraison (#264, point 7). Un paquet dont il ne reste aucun fichier à jouer ne se lance pas (#272).
# L'interface, sans ou dans le navigateur, ne s'y joue jamais.
# Un ensemble dont l'empreinte, dans l'index, est déjà trouvée verte — par l'attestation de la branche
# connue de ce clone, ou parce que c'est celle de la base commune avec `main` — ne se rejoue pas (#266,
# `attestation.mjs plan`). Dans ce qui se joue, le lanceur saute chaque fichier de test vert sur son
# empreinte, l'état de ce qu'il lit (D83, #304), et atteste ceux qu'il joue verts, empreinte calculée
# sur la copie de travail (#302). Il dit, pour chaque ensemble, s'il l'a joué, à quel seuil, avec quel verdict, ou
# pourquoi il ne l'a pas joué, combien de fichiers il a joués et sautés (`attestation.mjs bilan`) ; le détail est conservé (#352).
# `verdict.mjs` trie les échecs par fichier :
#   - un échec de la non-régression refuse le commit ;
#   - le harnais du besoin est affiché sans bloquer (la livraison le bloque, #121), sauf une erreur de
#     syntaxe, qui refuse le commit ; un import introuvable est signalé à part (Q2 de #127).
# Un script de test absent fait échouer le crochet. Un outil manquant fait sauter le test qui en a
# besoin, avec un message, sauf si TIRELIRE_STRICT est posé.
set -u

# Pendant une fusion (conflit), le pré-commit juge l'index comme la pré-fusion (#121).
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exec sh "$(dirname "$0")/livraison.sh" fusion
fi

racine=$(git rev-parse --show-toplevel) || exit 1
cd "$racine" || exit 1
fichiers=$(git -c core.quotePath=false diff --cached --name-only --no-renames) || exit 1

coeur='' garde='' relais='' hebergement=''
while IFS= read -r f; do
  case $f in
    packages/core/*) coeur=1 ;;
    packages/gardes/* | .github/* | docs/gardes.md) garde=1 ;;
    docs/decisions.md | docs/methodes.md | docs/description-projet.md | docs/invariants.md | docs/contraintes.md | CLAUDE.md) garde=1 ;;
    apps/relay/*) relais=1 ;;
    apps/hebergement/*) hebergement=1 ;;
  esac
done <<FIN
$fichiers
FIN

if [ -z "$coeur$garde$relais$hebergement" ]; then
  echo "pré-commit : aucun test concerné par ces fichiers — garde, cœur, relais, hébergement et harnais du besoin non joués ; l'interface, sans ou dans le navigateur, ne se joue jamais au pré-commit (le pré-push et la CI jugent le reste)."
  exit 0
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pré-commit : pnpm introuvable, les tests ne peuvent pas être joués." >&2
  exit 1
fi

journaux=$(mktemp -d) || exit 1
# Le détail du lancement (#352, point 3) — ce que chaque lancement a joué ou sauté, et la sortie de
# chaque exécuteur — reste lisible jusqu'au pré-commit suivant, dans le dossier de git.
detail="$(git rev-parse --absolute-git-dir)/tirelire-detail/pré-commit"
conserver() { rm -rf "$detail" && mkdir -p "$(dirname "$detail")" && cp -R "$journaux" "$detail" 2>/dev/null; rm -rf "$journaux"; }
trap conserver EXIT
trap 'exit 130' INT TERM
debut=$(date +%s)

# Le harnais du besoin se lit dans l'index : avant de retirer GIT_INDEX_FILE.
. "$racine/.githooks/harnais-du-besoin.sh"
harnais_du_besoin "$journaux/harnais.txt" >"$journaux/harnais.note" || exit 1
# Ce que l'attestation de la branche, connue de ce clone, a déjà trouvé vert sur l'empreinte de
# l'index, et l'empreinte de la base commune avec `main` (#266).
branche=$(git symbolic-ref --short -q HEAD) || branche=''
echo '[]' >"$journaux/verts"
[ -n "$branche" ] && node "$racine/.githooks/attestation.mjs" verts "$branche" "$journaux/verts" >/dev/null 2>&1
mbase=$(git merge-base HEAD refs/remotes/origin/main 2>/dev/null) || mbase=-
[ "$branche" = main ] && mbase=-
arbre=$(git write-tree) || exit 1
node "$racine/.githooks/attestation.mjs" plan "$arbre" 0 "$journaux/verts" "$journaux/harnais.txt" "$mbase" non "$journaux/plan" pré-commit || exit 1
joue() { awk -F '\t' -v id="$1" '$1 == id && $2 == 1 { ok = 1 } END { exit !ok }' "$journaux/plan"; }
# Un ensemble que le pré-commit ne joue pas sort du plan, en le disant.
ecarte() { # id nom raison
  echo "pré-commit : $2 : non joué — $3."
  awk -F '\t' -v OFS='\t' -v id="$1" '$1 == id { $2 = 0 } { print }' "$journaux/plan" >"$journaux/plan.n" && mv "$journaux/plan.n" "$journaux/plan"
}
for p in coeur:cœur garde:garde relais:relais hebergement:hébergement; do
  eval "touche=\$${p%%:*}"
  if [ -z "$touche" ]; then
    joue "${p%%:*}" && ecarte "${p%%:*}" "${p#*:}" "le commit ne touche aucun fichier qui le fasse jouer au pré-commit"
  elif ! joue "${p%%:*}"; then
    eval "${p%%:*}=''"
  fi
done
joue interface && ecarte interface 'interface sans navigateur' "l'interface ne se joue pas au pré-commit"
if [ -z "$coeur$garde$relais$hebergement" ]; then
  joue harnais && ecarte harnais 'harnais du besoin' 'il ne se joue que quand des tests se jouent'
  exit 0
fi
# Ses fichiers qui vivent dans le navigateur quittent la liste du commit (#272) : ils ne s'y jouent
# pas, et ne sont ni du harnais joué ni de la non-régression.
grep '^apps/web/test/navigateur/' "$journaux/harnais.txt" >"$journaux/harnais-navigateur.txt"
grep -v '^apps/web/test/navigateur/' "$journaux/harnais.txt" >"$journaux/harnais.joue"
mv "$journaux/harnais.joue" "$journaux/harnais.txt" || exit 1
# Fichiers de test `node --test` de chaque paquet, copie de travail comprise.
for d in packages/gardes apps/relay apps/hebergement; do
  git ls-files -co --exclude-standard -- "$d" | grep -E "^$d/[^/]*\.test\.[cm]?js\$" >"$journaux/$(basename "$d").fichiers"
done

# L'index est lu : les tests ne doivent plus rien hériter de git.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

dans() { grep -E "^$1/" "$journaux/harnais.txt" | sed "s#^$1/##"; }
lance() {
  nom=$1 dossier=$2
  shift 2
  (pnpm --dir "$dossier" run test "$@" --detail "$journaux/$nom.detail" >"$journaux/$nom.log" 2>&1; echo $? >"$journaux/$nom.code") &
  case $nom in harnais-*) id=harnais ;; cœur) id=coeur ;; hébergement) id=hebergement ;; *) id=$nom ;; esac
  case $nom in cœur | harnais-cœur | harnais-interface) sorte=vitest ;; *) sorte=node ;; esac
  printf '%s\t%s\t%s\n' "$id" "$nom" "$sorte" >>"$journaux/lances"
}
# Un lanceur node:test écrit aussi un rapport par fichier ; vitest, un rapport JSON.
lance_node() { # nom dossier seuil [fichiers…]
  ln_nom=$1 ln_dossier=$2 ln_seuil=$3
  shift 3
  lance "$ln_nom" "$ln_dossier" "$ln_seuil" --test-reporter=tap --test-reporter-destination=stdout \
    "--test-reporter=$racine/.githooks/rapport-node.mjs" "--test-reporter-destination=$journaux/$ln_nom.rapport" "$@"
}
lances=''

# Non-régression au seuil 0, sans les fichiers du harnais du besoin.
if [ -n "$coeur" ]; then
  set -- 0 --no-isolate --passWithNoTests --reporter=default --reporter=json "--outputFile.json=$journaux/cœur.rapport"
  for f in $(dans packages/core); do set -- "$@" --exclude "$f"; done
  lance cœur packages/core "$@"
  lances="$lances cœur:packages/core:vitest"
fi
non_regression_node() { # nom dossier
  if [ -n "$(dans "$2")" ]; then
    liste=$(grep -vxF -f "$journaux/harnais.txt" "$journaux/$(basename "$2").fichiers" | sed "s#^$2/##")
    [ -n "$liste" ] || return 0
    # shellcheck disable=SC2086 # un fichier par mot
    lance_node "$1" "$2" 0 $liste
  else
    lance_node "$1" "$2" 0
  fi
  lances="$lances $1:$2:node"
}
[ -n "$garde" ] && non_regression_node garde packages/gardes
[ -n "$relais" ] && non_regression_node relais apps/relay
[ -n "$hebergement" ] && non_regression_node hébergement apps/hebergement

# Harnais du besoin, en entier (seuil 4), sauf déjà vert sur son empreinte, paquet par paquet ; un
# paquet sans fichier à jouer ne se lance pas (#272).
joue harnais || : >"$journaux/harnais.lances"
joue harnais && cp "$journaux/harnais.txt" "$journaux/harnais.lances"
for d in $(grep -Eo '^(apps|packages)/[^/]+/' "$journaux/harnais.lances" | sed 's#/$##' | sort -u); do
  liste=$(dans "$d")
  [ -n "$liste" ] || continue
  case $d in
    packages/core)
      # shellcheck disable=SC2086
      lance harnais-cœur "$d" 4 --no-isolate --reporter=default --reporter=json "--outputFile.json=$journaux/harnais-cœur.rapport" $liste
      lances="$lances harnais-cœur:$d:vitest"
      ;;
    apps/web)
      # shellcheck disable=SC2086
      lance harnais-interface "$d" 4 --reporter=default --reporter=json "--outputFile.json=$journaux/harnais-interface.rapport" $liste
      lances="$lances harnais-interface:$d:vitest"
      ;;
    *)
      [ -f "$racine/$d/package.json" ] || continue
      n="harnais-$(basename "$d")"
      # shellcheck disable=SC2086
      lance_node "$n" "$d" 4 $liste
      lances="$lances $n:$d:node"
      ;;
  esac
done
wait

if [ -s "$journaux/harnais-navigateur.txt" ]; then
  echo "pré-commit : harnais du besoin dans le navigateur, non joué au commit (sans tests navigateur, D83) ; il se joue à la livraison (#264, point 7) : $(paste -sd ',' "$journaux/harnais-navigateur.txt" | sed 's/,/, /g')."
fi

# shellcheck disable=SC2086 # les lancements n'ont pas d'espace
node "$racine/.githooks/verdict.mjs" "$racine" "$journaux" "$debut" $lances
verdict=$?
node "$racine/.githooks/attestation.mjs" bilan "$journaux/plan" "$journaux" pré-commit "$arbre" - "${branche:-?}" "$journaux/verts"
echo "pré-commit : détail — chaque fichier joué ou sauté, et la sortie de chaque lancement : $detail/ (*.detail, *.log)."
exit $verdict
