#!/bin/sh
# Pré-commit de Tirelire (#120, #127) : moins de 5 s. Pendant une fusion, voir livraison.sh.
#
# Les tests se choisissent d'après les fichiers du commit (l'index) et se jouent sur la copie de
# travail, en parallèle :
#   packages/core/**                                   → tests du cœur (sans isolation, pour tenir le budget)
#   la garde (packages/gardes/**, amorcage/**, docs/gardes.md, .github/**)
#   ou les règles (docs/decisions.md, docs/description-projet.md, docs/invariants.md,
#   docs/contraintes.md, CLAUDE.md)                     → tests de la garde
#   apps/relay/**                                      → tests du relais
#   apps/hebergement/**                                → tests de l'hébergement
#   le reste (documentation, interface, configuration) → rien ; typecheck et build au pré-push, tout en CI.
# Parmi les tests joués, le harnais du besoin (`harnais-du-besoin.sh`) est l'ensemble des fichiers de
# test que la branche ajoute ou modifie depuis sa base commune avec origin/main ; le reste est la
# non-régression. Chaque paquet est joué une fois, et `verdict.mjs` trie ses échecs par fichier :
#   - un échec de la non-régression refuse le commit ;
#   - le harnais du besoin est affiché sans bloquer (la livraison le bloque, #121), sauf une erreur de
#     syntaxe, qui refuse le commit ; un import introuvable est signalé à part (Q2 de #127).
# Un script de test absent fait échouer le crochet. Un outil manquant fait sauter le test qui en a
# besoin, avec un message, sauf si TIRELIRE_STRICT est posé.
set -u

# Pendant une fusion (conflit), le pré-commit juge l'index comme la pré-fusion (#121).
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exec sh "$(dirname "$0")/livraison.sh" fusion
fi

racine=$(git rev-parse --show-toplevel) || exit 1
cd "$racine" || exit 1
fichiers=$(git -c core.quotePath=false diff --cached --name-only --no-renames) || exit 1

coeur='' garde='' relais='' hebergement=''
while IFS= read -r f; do
  case $f in
    packages/core/*) coeur=1 ;;
    packages/gardes/* | amorcage/* | .github/* | docs/gardes.md) garde=1 ;;
    docs/decisions.md | docs/description-projet.md | docs/invariants.md | docs/contraintes.md | CLAUDE.md) garde=1 ;;
    apps/relay/*) relais=1 ;;
    apps/hebergement/*) hebergement=1 ;;
  esac
done <<FIN
$fichiers
FIN

if [ -z "$coeur$garde$relais$hebergement" ]; then
  echo "pré-commit : aucun test concerné par ces fichiers (le pré-push et la CI jugent le reste)."
  exit 0
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pré-commit : pnpm introuvable, les tests ne peuvent pas être joués." >&2
  exit 1
fi

journaux=$(mktemp -d) || exit 1
trap 'rm -rf "$journaux"' EXIT
trap 'exit 130' INT TERM
debut=$(date +%s)

# Le harnais du besoin se lit dans l'index : avant de retirer GIT_INDEX_FILE.
. "$racine/.githooks/harnais-du-besoin.sh"
harnais_du_besoin "$journaux/harnais.txt" >"$journaux/harnais.note" || exit 1

# L'index est lu : les tests ne doivent plus rien hériter de git.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

lance() {
  nom=$1 dossier=$2
  shift 2
  (pnpm --dir "$dossier" run test "$@" >"$journaux/$nom.log" 2>&1; echo $? >"$journaux/$nom.code") &
}
# Un lanceur node:test écrit aussi un rapport par fichier ; vitest, un rapport JSON.
lance_node() {
  lance "$1" "$2" --test-reporter=tap --test-reporter-destination=stdout \
    "--test-reporter=$racine/.githooks/rapport-node.mjs" "--test-reporter-destination=$journaux/$1.rapport"
}

lances=''
[ -n "$coeur" ] && { lance cœur packages/core --no-isolate --reporter=default --reporter=json "--outputFile.json=$journaux/cœur.rapport"; lances="$lances cœur:packages/core:vitest"; }
[ -n "$garde" ] && { lance_node garde packages/gardes; lances="$lances garde:packages/gardes:node"; }
[ -n "$relais" ] && { lance_node relais apps/relay; lances="$lances relais:apps/relay:node"; }
[ -n "$hebergement" ] && { lance_node hébergement apps/hebergement; lances="$lances hébergement:apps/hebergement:node"; }
wait

# shellcheck disable=SC2086 # les lancements n'ont pas d'espace
node "$racine/.githooks/verdict.mjs" "$racine" "$journaux" "$debut" $lances
